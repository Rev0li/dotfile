# ═══════════════════════════════════════════════════════════
# 🚫 Fichiers et dossiers à ignorer
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# 📁 Configurations locales
# ─────────────────────────────────────────────
# Configuration locale (contient des secrets, tokens, etc.)
zsh/local.zsh

# ─────────────────────────────────────────────
# 🗃️ Backups
# ─────────────────────────────────────────────
*_backup_*/
backup_*/
*.backup

# ─────────────────────────────────────────────
# 📝 Logs et temporaires
# ─────────────────────────────────────────────
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────
# 🔧 Fichiers système
# ─────────────────────────────────────────────
discord/
pulse/
.vscode/
.idea/
*.swp
*.swo
*~

# ─────────────────────────────────────────────
# 📦 Binaires téléchargés (bin/) — recréés par install.sh
# Tout le contenu de bin/ est ignoré (binaires + dossiers extraits) ;
# le dossier est recréé par install.sh (mkdir -p).
# ─────────────────────────────────────────────
bin/*

# ─────────────────────────────────────────────
# 🎨 Fichier d'état du thème (local à la machine)
# ─────────────────────────────────────────────
# Pas dans le repo — géré par theme-toggle.sh sur chaque machine
# ~/.config/theme et ~/.config/theme-env sont hors du repo de toute façon

# ─────────────────────────────────────────────
# 🗂️ Archives
# ─────────────────────────────────────────────
*.zip
*.tar.gz
*.tar.xz
*.deb
*.rpm
